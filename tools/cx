#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [[ -z "${XDG_CACHE_HOME:-}" ]]; then
  export XDG_CACHE_HOME="$PROJECT_ROOT/.cache"
fi

mkdir -p "$XDG_CACHE_HOME"

if ! command -v cx >/dev/null 2>&1; then
  echo "cx not found in PATH" >&2
  exit 127
fi

args=("$@")

has_explicit_root=0
for arg in "${args[@]}"; do
  if [[ "$arg" == "--root" || "$arg" == --root=* ]]; then
    has_explicit_root=1
    break
  fi
done

if [[ "$has_explicit_root" -eq 1 ]]; then
  exec cx "${args[@]}"
fi

resolve_path() {
  realpath -m -- "$1"
}

git_root_for_path() {
  local target="$1"
  local dir="$target"

  if [[ ! -d "$dir" ]]; then
    dir=$(dirname -- "$dir")
  fi

  git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true
}

pick_deeper_root() {
  local candidate="$1"

  if [[ -z "$candidate" ]]; then
    return
  fi

  if [[ -z "${selected_root:-}" || "${#candidate}" -gt "${#selected_root}" ]]; then
    selected_root="$candidate"
  fi
}

normalize_path_arg() {
  local index="$1"
  local resolved_path
  local path_root

  if (( index >= ${#resolved_args[@]} )); then
    return
  fi

  resolved_path=$(resolve_path "${resolved_args[$index]}")
  resolved_args[$index]="$resolved_path"

  path_root=$(git_root_for_path "$resolved_path")
  pick_deeper_root "$path_root"
}

resolved_args=("${args[@]}")
command_index=-1

for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --root)
      ((i++))
      ;;
    --root=*|--json|-h|--help|-V|--version)
      ;;
    *)
      command_index=$i
      break
      ;;
  esac
done

selected_root=""

if (( command_index >= 0 )); then
  case "${args[$command_index]}" in
    overview|o)
      normalize_path_arg $((command_index + 1))
      ;;
    symbols|s|references|r)
      for ((i = command_index + 1; i < ${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--file" ]]; then
          normalize_path_arg $((i + 1))
          break
        fi
      done
      ;;
    definition|d)
      for ((i = command_index + 1; i < ${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--from" ]]; then
          normalize_path_arg $((i + 1))
          break
        fi
      done
      ;;
  esac
fi

if [[ -z "$selected_root" ]]; then
  pick_deeper_root "$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -z "$selected_root" ]]; then
  selected_root="$PROJECT_ROOT"
fi

exec cx --root "$selected_root" "${resolved_args[@]}"
